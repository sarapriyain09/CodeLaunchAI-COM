## Orchestrator config (example)

# OpenAI (text)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional legacy local gateway
# GPT_CHAT_BASE_URL=http://localhost:7070

# Auth + Subscription (used to gate downloads only)
# GOOGLE_CLIENT_ID=
# JWT_SECRET=change-me
# JWT_TTL_MINUTES=43200

# Require subscription to download ZIP exports.
# MVP implementation is email allowlist.
# SUBSCRIPTION_REQUIRED=true
# SUBSCRIBER_EMAILS=you@company.com,other@company.com

# Stripe subscription (optional). If configured, users can subscribe to unlock downloads.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Recommended (app-generator MVP): Student/Pro with monthly + yearly.
# STRIPE_PRICE_STUDENT_MONTHLY=price_...
# STRIPE_PRICE_STUDENT_YEARLY=price_...
# STRIPE_PRICE_PRO_MONTHLY=price_...
# STRIPE_PRICE_PRO_YEARLY=price_...

# Optional: if you only have one price per tier.
# STRIPE_PRICE_STUDENT=price_...
# STRIPE_PRICE_PRO=price_...

# Optional: monthly/yearly split for a single tier.
# STRIPE_PRICE_ID_MONTHLY=price_...
# STRIPE_PRICE_ID_YEARLY=price_...

# Legacy (back-compat): a single Price ID.
# STRIPE_PRICE_ID=price_...

# Recommended: per-plan price ids (monthly + yearly).
# Website (£15/mo) / (£162/yr with 10% off)
# STRIPE_PRICE_WEBSITE_MONTHLY=price_...
# STRIPE_PRICE_WEBSITE_YEARLY=price_...
# Business (£25/mo) / (£270/yr with 10% off)
# STRIPE_PRICE_BUSINESS_MONTHLY=price_...
# STRIPE_PRICE_BUSINESS_YEARLY=price_...
# E-commerce (£39/mo) / (£421.20/yr with 10% off)
# STRIPE_PRICE_ECOMMERCE_MONTHLY=price_...
# STRIPE_PRICE_ECOMMERCE_YEARLY=price_...
# APP_BASE_URL=http://localhost:8080/app/

# Optional: if you use a standalone HTML subscription page (not inside the React app)
# BILLING_SUCCESS_URL=http://localhost:8080/subscribe.html?subscribed=1
# BILLING_CANCEL_URL=http://localhost:8080/subscribe.html?canceled=1

# Workspaces + tooling
# WORKSPACES_DIR=generated_workspaces
# NPM_CMD=npm.cmd

# Database (Postgres)
# Example:
# DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/codelaunch

# CORS (when hosting frontend separately)
# Comma-separated origins. Example:
# CORS_ALLOW_ORIGINS=http://localhost:5173,https://app.yourdomain.com
# CORS_ALLOW_CREDENTIALS=false

# Optional: AI image generation (writes PNGs into generated workspace public/assets/)
# NOTE: this uses OpenAI Images API and will consume credits.
# GENERATE_IMAGES=false
# MAX_IMAGES_PER_PROJECT=6
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_SIZE=1024x1024
